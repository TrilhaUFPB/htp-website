# Supabase 
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Actions cron auth for /api/cron/keep-warm
CRON_SECRET=

# Resend 
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# RESEND_FROM_EMAIL=

# PostHog (analytics off when the key is unset). Before setting the key, turn on
# two project settings: cookieless mode (the client runs cookieless_mode:
# "always") and "Discard client IP data", which /privacidade promises.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Optional — canonical site URL for SEO metadata
# NEXT_PUBLIC_SITE_URL=https://www.hackthepath.com.br
